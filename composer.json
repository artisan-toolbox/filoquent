{
  "$schema": "https://getcomposer.org/schema.json",
  "name": "artisan-toolbox/filoquent",
  "description": "Preview foundations for connecting Laravel's filesystem to Eloquent model attributes.",
  "keywords": [
    "laravel",
    "artisan-toolbox",
    "filoquent"
  ],
  "homepage": "https://github.com/artisan-toolbox/filoquent",
  "license": "MIT",
  "authors": [
    {
      "name": "Allan Mariucci Carvalho",
      "email": "contact@atb.dev.br",
      "role": "Developer"
    }
  ],
  "require": {
    "php": "^8.5",
    "artisan-toolbox/maintainer": "^1.10.0",
    "illuminate/console": "^13.0",
    "illuminate/database": "^13.0",
    "illuminate/filesystem": "^13.0",
    "illuminate/http": "^13.0",
    "illuminate/log": "^13.0",
    "illuminate/support": "^13.0",
    "laravel/prompts": "^0.3.25",
    "symfony/http-foundation": "^7.4 || ^8.0",
    "symfony/mime": "^7.4 || ^8.0"
  },
  "require-dev": {
    "brianium/paratest": "~7.27.5",
    "driftingly/rector-laravel": "^2.7.3",
    "larastan/larastan": "^3.9",
    "laravel/pao": "^1.0",
    "laravel/pint": "^1.29",
    "orchestra/testbench": "^10.0||^11.0",
    "pestphp/pest": "^4.6||^5.0",
    "pestphp/pest-plugin-laravel": "^4.1||^5.0",
    "pestphp/pest-plugin-phpstan": "^5.3",
    "pestphp/pest-plugin-type-coverage": "^5.1",
    "phpstan/extension-installer": "^1.4",
    "phpstan/phpstan-mockery": "^2.0",
    "phpstan/phpstan": "^2.3.5",
    "rector/rector": "^2.8.4"
  },
  "autoload": {
    "psr-4": {
      "ArtisanToolbox\\Filoquent\\": "src/"
    }
  },
  "autoload-dev": {
    "psr-4": {
      "ArtisanToolbox\\Filoquent\\Tests\\": "tests/",
      "Workbench\\App\\": "workbench/app/",
      "Workbench\\Database\\Factories\\": "workbench/database/factories/",
      "Workbench\\Database\\Seeders\\": "workbench/database/seeders/"
    }
  },
  "scripts": {
    "post-autoload-dump": [
      "@clear",
      "@prepare"
    ],
    "prepare": [
      "@php vendor/bin/testbench package:discover --ansi"
    ],
    "build": [
      "@php vendor/bin/testbench workbench:build --ansi"
    ],
    "serve": [
      "Composer\\Config::disableProcessTimeout",
      "@build",
      "@php vendor/bin/testbench serve --ansi"
    ],
    "lint": [
      "vendor/bin/pint --parallel"
    ],
    "lint:check": [
      "vendor/bin/pint --parallel --test"
    ],
    "refactor": [
      "vendor/bin/rector process --no-progress-bar"
    ],
    "refactor:check": [
      "vendor/bin/rector process --dry-run --no-progress-bar"
    ],
    "analyse": [
      "vendor/bin/phpstan analyse --memory-limit=512M"
    ],
    "test:types": [
      "vendor/bin/pest --type-coverage --min=100 --memory-limit=512M --no-cache"
    ],
    "test:unit": [
      "vendor/bin/pest --parallel"
    ],
    "test": [
      "@analyse",
      "@refactor:check",
      "@lint:check",
      "@test:types",
      "@test:unit"
    ],
    "clear": [
      "@php vendor/bin/testbench package:purge-skeleton --ansi"
    ]
  },
  "extra": {
    "laravel": {
      "providers": [
        "ArtisanToolbox\\Filoquent\\FiloquentServiceProvider"
      ]
    }
  },
  "config": {
    "sort-packages": true,
    "allow-plugins": {
      "pestphp/pest-plugin": true,
      "phpstan/extension-installer": true
    }
  },
  "minimum-stability": "stable",
  "prefer-stable": true,
  "suggest": {
    "illuminate/redis": "Required for the optional Redis upload journal (^13.0).",
    "ext-redis": "Use the phpredis driver for the optional Redis upload journal.",
    "predis/predis": "Use the predis driver for the optional Redis upload journal."
  }
}
